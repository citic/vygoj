msgstr "Sin conexión con el backend"

msgid "Not found"
msgstr "No encontrado"

msgid ""
"Optional. Claim that tells professors from students, e.g. groups or "
"realm_access.roles"
msgstr ""
"Opcional. Claim que distingue a los profesores de los estudiantes, p. ej."
" groups o realm_access.roles"

