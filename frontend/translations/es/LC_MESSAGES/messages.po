msgstr "Control de usuario"

msgid "User credentials"
msgstr "Credenciales del usuario"

msgid "User identifier"
msgstr "Identificador de usuario"

msgid "User information"
msgstr "Información del usuario"

msgid "User logged out"
msgstr "Sesión cerrada"

msgid "User login"
msgstr "Inicio de sesión"

msgid "User preferences"
msgstr "Preferencias del usuario"

msgid "Username"
msgstr "Usuario"

msgid "Username/Email"
msgstr "Usuario/correo"

msgid "Users"
msgstr "Usuarios"

#, python-format
msgid "Users (%(count)d)"
msgstr "Usuarios (%(count)d)"

msgid ""
"Values of that claim that mean professor, separated by commas. Other new "
"users are students."
msgstr ""
"Valores de ese claim que indican profesor, separados por comas. Los demás"
" usuarios nuevos son estudiantes."

msgid "Vygotsky Online Judge"
msgstr "Juez en línea Vygotsky"

msgid "Write a claim name, or names separated by dots"
msgstr "Escriba el nombre de un claim, o nombres separados por puntos"

msgid "Write a valid email, or leave it empty"
msgstr "Escriba un correo válido, o déjelo vacío"

msgid "Write an https:// URL"
msgstr "Escriba un URL https://"

msgid "Write scopes separated by spaces, including openid"
msgstr "Escriba scopes separados por espacios, incluido openid"

msgid "You cannot change your own role."
msgstr "No puede cambiar su propio rol."

msgid "You cannot suspend nor delete yourself."
msgstr "No puede suspenderse ni eliminarse a sí mismo."

msgid "Your account is suspended. Ask the administrator."
msgstr "Su cuenta está suspendida. Consulte al administrador."

#, python-format
msgid ""
"Your account of %(provider)s is not registered in VygOJ. Ask your "
"professor."
msgstr ""
"Su cuenta de %(provider)s no está registrada en VygOJ. Consulte a su "
"profesor."

msgid "Your account was deleted."
msgstr "Su cuenta fue eliminada."

#, python-format
msgid "Your email is not verified by %(provider)s."
msgstr "Su correo no está verificado por %(provider)s."

msgid "Your output"
msgstr "Su salida"

msgid ""
"Your session expired or the request was not valid. Reload the page and "
"try again."
msgstr ""
"Su sesión expiró o la solicitud no era válida. Recargue la página e "
"intente de nuevo."

msgid "Your solution"
msgstr "Su solución"

#, python-format
msgid "could not connect to the server (%(message)s)"
msgstr "no se pudo conectar con el servidor (%(message)s)"

msgid ""
"e.g. https://sso.ucr.ac.cr/realms/UCR or its /.well-known/openid-"
"configuration URL"
msgstr ""
"p. ej. https://sso.ucr.ac.cr/realms/UCR o su URL /.well-known/openid-"
"configuration"

msgid "or with your VygOJ password"
msgstr "o con su contraseña de VygOJ"

#, python-format
msgid "the server answered %(status)s %(text)s"
msgstr "el servidor respondió %(status)s %(text)s"

#, python-format
msgid "the server did not answer in %(seconds)s seconds"
msgstr "el servidor no respondió en %(seconds)s segundos"

