msgid ""
"Not configured: public client with PKCE only. Add it to "
"SSO_CLIENT_SECRETS in config.py."
msgstr ""
"No configurado: cliente público, solo con PKCE. Agréguelo a "
"SSO_CLIENT_SECRETS en config.py."

