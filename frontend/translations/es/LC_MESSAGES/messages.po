#, python-format
msgid " (CPU %(seconds)s s)"
msgstr " (CPU %(seconds)s s)"

#, python-format
msgid "%(passed)s test cases passed (%(points)s points)"
msgstr "%(passed)s casos de prueba aprobados (%(points)s puntos)"

