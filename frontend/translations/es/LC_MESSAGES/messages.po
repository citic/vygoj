msgstr "Cortar"

msgid "Dark mode"
msgstr "Modo oscuro"

msgid "Deadline"
msgstr "Fecha límite"

msgid "Default"
msgstr "Predeterminado"

msgid "Delete"
msgstr "Eliminar"

