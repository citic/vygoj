msgstr "Scopes"

msgid "Separated by spaces, e.g. openid profile email"
msgstr "Separados por espacios, p. ej. openid profile email"

msgid ""
"Short name for URLs and for SSO_CLIENT_SECRETS in config.py, e.g. ucr. It"
" cannot be changed later."
msgstr ""
"Nombre corto para los URL y para SSO_CLIENT_SECRETS en config.py, p. ej. "
"ucr. No se puede cambiar después."

msgid "Shown in the login button, e.g. Universidad de Costa Rica"
msgstr "Se muestra en el botón de ingreso, p. ej. Universidad de Costa Rica"

msgid "Site logo"
msgstr "Logo del sitio"

msgid "Standard error output"
msgstr "Salida de error estándar"

