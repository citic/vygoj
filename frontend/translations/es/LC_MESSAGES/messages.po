msgstr "Conexión"

msgid "Contents"
msgstr "Contenido"

msgid "Copy"
msgstr "Copiar"

#, python-format
msgid "Could not connect with %(provider)s. Try again later."
msgstr "No se pudo conectar con %(provider)s. Intente más tarde."

#, python-format
msgid "Could not log in with %(provider)s. Try again later."
msgstr "No se pudo ingresar con %(provider)s. Intente más tarde."

#, python-format
msgid "Could not log in with %(provider)s. Try again."
msgstr "No se pudo ingresar con %(provider)s. Intente de nuevo."

#, python-format
msgid "Could not run the solution: %(error)s"
msgstr "No se pudo ejecutar la solución: %(error)s"

msgid "Create an account for users who are not registered in VygOJ"
msgstr "Crear una cuenta a los usuarios que no están registrados en VygOJ"

