<% layout('./layout') %>
      <main class="admin_my_courses">
<% if (it.user && it.user.isProfessor()) { %>
        <article id="admin_article" class="courses_section admin_article">
          <h3>Repositories and courses</h3>
          <p>Courses are stored in Git repositories. A repository contains activities, such as questions, programming problems, and courses. Vygoj searches for courses in <code>courses/</code> subfolder in the root of the repository. For each course a <a href="/json/course_name.json" download="course_name.json">course configuration file</a> (e.g: <code>/courses/course_name.json</code>) is created. This file provides the course properties, such as its title, duration, and its contents. The course content is a hierarchical list of links to the activities stored in the rest of the repository.</p>

          <form action="/course/admin" method="post">
            <fieldset id="new_repo">
              <legend>New repository</legend>
              <label for="new_repo_url">Repository address</label>
              <input type="url" id="new_repo_url" name="new_repo_url" placeholder="URL" minlength="10" required="required"/>
              <small>If this repository is private, <a href="/help/course/admin">give access to Vygoj</a> before adding it.</small>
              <p class="button_bar">
                <button id="add_button" class="button confirm small" type="submit" name="action" value="add_repo">Add Repository</button>
              </p>
            </fieldset>
          </form>
        </article>
<% } else { %>
        <h2 class="error">Not allowed</h2>
        <p>Only professors are allowed to administer their courses</p>
<% } %>
      </main>
