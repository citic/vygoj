<% layout('./layout') %>
      <main class="courses">
<% if (it.user && it.user.isAdmin()) { %>
        <article id="admin_article" class="courses_section admin_article">
          <header class="course_section__header">
            <h3>Administration</h3>
          </header>
          <div id="admin_panel" class="panel">
            <a class="icon_control" href="/users/admin">
              <img class="icon_control__image" src="/icon/user-detail.svg" alt="Admin Users"/>
              <span class="icon_control__caption">Users</span>
            </a>
          </div>
        </article>
<% } %>
<% if (it.myCourses.length > 0) { %>
        <article id="my_courses" class="courses_section courses--mine">
          <header class="course_section__header">
            <h3 class="course_section__title">My courses</h3>
<% if (it.user && it.user.isProfessor()) { %>
            <a href="/course/admin" class="button confirm small">Add Course</a>
<% } %>
          </header>
          <div class="course_list">
<% it.myCourses.forEach((course) => { %>
<%~ includeFile('partials/course_entry', course) %>
<% }); %>
          </div>
        </article>
<% } %>
<% if (it.availableCourses.length > 0) { %>
        <article id="available_courses" class="course_section courses--available">
          <header class="course_section__header">
            <h3 class="course_section__title">Available courses</h3>
          </header>
          <div class="course_list">
<% it.availableCourses.forEach((course) => { %>
<%~ includeFile('partials/course_entry', course) %>
<% }); %>
          </div>
        </article>
<% } %>
      </main>
