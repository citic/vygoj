<% layout('./layout') %>
      <main class="user_preferences">
        <h2>Preferences for <%= it.user.role %> user <%= it.user.name %></h2>
<% if (it.errorMessage) { %>
        <p class="login_message error"><%= it.errorMessage %></p>
<% } %>
        <form class="preferences_form" action="/user/preferences" method="post">
          <fieldset class="user_information">
            <legend>User information</legend>
            <label for="name">Full name</label>
            <input type="text" name="name" id="name" required="required" value="<%= it.user.name %>"/>
            <label for="email">E-Mail</label>
            <input type="email" name="email" id="email" required="required" value="<%= it.user.email %>"/>
          </fieldset>
          <fieldset class="user_password">
            <legend>Change password</legend>
            <label for="current_password">Current password</label>
            <input type="password" name="current_password" id="current_password"/>
            <label for="new_password">New password</label>
            <input type="password" name="new_password" id="new_password"/>
          </fieldset>
          <fieldset class="preferences">
            <p>Interface Mode:
              <input type="radio" id="light_mode" name="ui_mode" value="light"<%~ it.user.uiMode === 'light' ? ' checked="checked"' : '' %>/>
              <label for="light_mode">Light</label>
              <input type="radio" id="dark_mode" name="ui_mode" value="dark"<%~ it.user.uiMode === 'dark' ? ' checked="checked"' : '' %>/>
              <label for="dark_mode">Dark</label>
            </p>
          </fieldset>
          <p>
            <button class="button confirm" type="submit" name="action" value="update">Update</button>
            <button class="button reject" type="submit" name="action" value="logout">Logout</button>
            <button class="button danger" type="submit" name="action" value="delete">Delete Account</button>
          </p>
        </form>
      </main>
