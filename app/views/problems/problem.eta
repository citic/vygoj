<% layout('./layout') %>
      <main id="problem" class="problem" data-name="<%= it.problem.name %>">
        <article class="problem__description">
          <h3 class="problem__title"><%= it.problem.title %></h3>
          <div class="problem__statement"><%~ it.problem.statement %></div>
        </article>
        <section class="problem__solution">
          <h4>Your C/C++ solution</h4>
          <div id="code_editor" class="editor"></div>
        </section>
        <section class="solution__evaluation">
          <div class="row">
            <p>
              <button id="run_button" class="button action" disabled="disabled" title="Run my solution against the test cases">Run</button>
              <button id="finish_button" class="button confirm" name="finish" value="finish" title="Return to the course">Finish</button>
            </p>
            <p id="score">
              <span id="passed_test_count">0</span>/<span id="total_test_count"><%= it.problem.tests.length %></span>
              test cases passed (<span id="user_points">0</span>/<span id="total_points"><%= it.problem.calculateTotalPoints() %></span> points)</p>
          </div>
          <div id="diagnostics_wrapper" class="hidden">
            <em class="error">Compiler output</em>
            <pre id="diagnostics" class="output">No errors</pre>
          </div>
          <div id="test_cases">
<% it.problem.tests.forEach((test, index) => { %>
            <button class="test_button button small" title="Test case <%= index + 1 %>"><%= index + 1 %></button>
<% }); %>
          </div>
          <div id="active_test" class="row top">
            <div id="active_test_input_wrapper" class="editor_wrapper">
              <em id="active_test_input_label">Input</em>
              <div id="active_test_input" class="editor"></div>
            </div>
            <div id="active_test_expected_output_wrapper" class="editor_wrapper">
              <em id="active_test_expected_output_label">Expected output</em>
              <div id="active_test_expected_output" class="editor"></div>
            </div>
            <div id="active_test_user_output_wrapper" class="editor_wrapper">
              <em id="active_test_user_output_label">Your output</em>
              <div id="active_test_user_output" class="editor"></div>
            </div>
          </div>
          <div id="stderr_wrapper" class="hidden">
            <em class="error">Standard error output</em>
            <pre id="stderr" class="output"></pre>
          </div>
        </section>
      </main>
