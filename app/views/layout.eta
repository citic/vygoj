<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta charset="utf-8"/>
    <title><%= it.title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="author" content="Jeisson Hidalgo-Céspedes"/>
    <link rel="stylesheet" href="/css/<%= it.stylesheet ?? 'site' %>.css"/>
  </head>
  <body>
    <header class="site_header">
      <h1 class="site_header__title">Vygotsky Online Judge</h1>
      <nav class="breadcumb">
        <ul class="breadcumb__list">
          <li class="breadcumb__item">
            <a href="/">Home</a>
          </li>
<% if (it.breadcumbs) { %>
<%   it.breadcumbs.forEach((link) => { %>
          <li class="breadcumb__item">
            <a href="<%= link.href %>"><%= link.text %></a>
          </li>
<%   }); %>
<% } %>
        </ul>
      </nav>
    </header>
<%~ it.body %>
    <footer class="site_footer">
      <small>Vygoj v1.0.0</small>
    </footer>
  </body>
</html>
