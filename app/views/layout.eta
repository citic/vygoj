<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta charset="utf-8"/>
    <title><%= it.title ?? 'Vygotsky Online Judge' %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="author" content="Jeisson Hidalgo-Céspedes"/>
    <link rel="preload" href="/css/site.css" as="style"/>
<% if (it.stylesheet) { %>
    <link rel="preload" href="/css/<%= it.stylesheet %>.css" as="style"/>
<% } %>
    <link rel="stylesheet" href="/css/<%= it.stylesheet ?? 'site' %>.css"/>
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg"/>
  </head>
  <body>
    <header class="site_header">
      <div class="site_header--row">
        <a href="/"><img class="site_logo" src="/img/logo.svg" alt="Site logo" width="64" height="64"/></a>
        <h1 class="site_header__title">Vygotsky Online Judge</h1>
        <a class="icon_control" href="/user/<%= it.user?._id ?? 'login' %>">
          <img class="icon_control__image" src="/icon/user.svg" alt="User control" width="44" height="44"/>
          <span class="icon_control__caption"><%= it.user?.name ?? 'User' %></span>
        </a>
      </div>
      <nav class="breadcumbs filled">
        <ul class="breadcumb__list">
          <li class="breadcumb__item">
            <a href="/">Home</a>
          </li>
<% if (it.breadcumbs) { %>
<%   it.breadcumbs.forEach((link) => { %>
          <li class="breadcumb__item">
            <a href="<%= link.href %>"><%= link.text %></a>
          </li>
<%   }); %>
<% } %>
        </ul>
      </nav>
    </header>
    <div class="page_content">
<%~ it.body %>
    </div>
    <footer class="site_footer filled">
      <span id="software_version" class="software_version">Vygoj v0.0.1</span>
      <span id="backend_status">
        <span id="backend_offline" class="hidden">
          <%~ includeFile('../public/icon/cloud_offline.svg') %> 
        </span>
        <span id="backend_online" class="hidden">
          <%~ includeFile('../public/icon/cloud_online.svg') %> 
        </span>
      </span>
      <span class="help_controls"><a href="/help">Help</a></span>
    </footer>
<% if (it.scripts) { %>
<%   it.scripts.forEach((script) => { %>
    <script src="<%= script %>" type="module" async="async"></script>
<%   }); %>
<% } else { %>
    <script src="/js/site.js" type="module" async="async"></script>
<% } %>
  </body>
</html>
