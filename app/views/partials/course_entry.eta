            <section class="course_item">
              <img class="course__image" src="<%= it.image %>" alt="<%= it.title %>" width="64" height="60"/>
              <div class="course__details">
                <h4 class="course__header">
                  <a href="/course/<%= it.id %>">
                    <span class="course__code"><%= it.code %></span>
                    <span class="course__title"><%= it.title %></span>
                  </a>
                </h4>
                <p class="course__instructors">
<% it.instructors.forEach((instructor) => { %>
                  <a href="/prof/<%= instructor.id %>"><%= instructor.name %></a>
<% }); %>
                </p>
                <p class="course_statistics"><%= it.statistics.students %> students, <%= it.statistics.sections %> sections, <%= it.statistics.problems %> problems, <%= it.statistics.questions %> questions.</p>
              </div>
            </section>
